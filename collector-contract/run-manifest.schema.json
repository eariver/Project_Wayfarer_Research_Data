{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eariver/Project_Wayfarer_Research_Data/main/collector-contract/run-manifest.schema.json",
  "title": "Project Wayfarer acquisition run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "phase",
    "run_type",
    "scheduled_at",
    "started_at",
    "finished_at",
    "status",
    "expected_targets",
    "attempted_targets",
    "successful_targets",
    "failed_targets",
    "files",
    "collector"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "run_manifest"},
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "phase": {"enum": ["phase-a", "phase-b", "phase-c", "manual", "bootstrap"]},
    "run_type": {
      "enum": [
        "server_ping",
        "ranking_score",
        "ranking_player",
        "ranking_recent",
        "full_listing",
        "mixed"
      ]
    },
    "scheduled_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "status": {"enum": ["success", "partial", "failure"]},
    "expected_targets": {"type": "integer", "minimum": 0},
    "attempted_targets": {"type": "integer", "minimum": 0},
    "successful_targets": {"type": "integer", "minimum": 0},
    "failed_targets": {"type": "integer", "minimum": 0},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "record_type", "record_count"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(raw|samples)/[A-Za-z0-9._/+:-]+$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "record_type": {
            "enum": ["server_ping", "minecraft_jp_ranking", "run_manifest"]
          },
          "record_count": {"type": "integer", "minimum": 0}
        }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "execution_environment"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "execution_environment": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "notes": {
      "oneOf": [
        {"type": "string", "maxLength": 2048},
        {"type": "null"}
      ]
    }
  }
}
