{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eariver/Project_Wayfarer_Research_Data/main/collector-contract/minecraft-jp-ranking-record.schema.json",
  "title": "Project Wayfarer minecraft.jp ranking record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "run_id",
    "captured_at",
    "ranking_type",
    "rank",
    "server_id",
    "listing_id",
    "listing_url",
    "display_name",
    "listed_address",
    "listed_version",
    "score",
    "players_online",
    "players_max",
    "votes_30d",
    "availability_ratio",
    "tags",
    "source",
    "collector"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "minecraft_jp_ranking"},
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "captured_at": {"type": "string", "format": "date-time"},
    "ranking_type": {"enum": ["score", "player", "recent", "full_listing"]},
    "rank": {"type": "integer", "minimum": 1},
    "server_id": {
      "oneOf": [
        {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"},
        {"type": "null"}
      ]
    },
    "listing_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "listing_url": {"type": "string", "format": "uri"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 256},
    "listed_address": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 253},
        {"type": "null"}
      ]
    },
    "listed_version": {
      "oneOf": [
        {"type": "string", "maxLength": 256},
        {"type": "null"}
      ]
    },
    "score": {
      "oneOf": [
        {"type": "number", "minimum": 0},
        {"type": "null"}
      ]
    },
    "players_online": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "players_max": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "votes_30d": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "null"}
      ]
    },
    "availability_ratio": {
      "oneOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "null"}
      ]
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}
    },
    "source": {"const": "minecraft.jp"},
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    }
  }
}
